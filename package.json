{
  "name": "jasasaja-personal-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:api": "tsx watch --env-file-if-exists=.env server/src/server.ts",
    "api": "tsx --env-file-if-exists=.env server/src/server.ts",
    "build": "vite build",
    "dev:next": "next dev --port 3100",
    "build:next": "next build",
    "start:next": "next start --port 3100",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit && tsc --noEmit -p server/tsconfig.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server/tsconfig.json",
    "test": "tsx --test $(find src server/src -name '*.test.ts' -type f | sort)",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file-if-exists=.env server/src/db/seed/seed.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "lucide-react": "^0.546.0",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^22.14.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "0.31.11",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "7.0.2"
  }
}
