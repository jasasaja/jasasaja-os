# JASASAJA Personal OS - environment template (local development only)
# Copy to .env and adjust values locally. Never commit real secrets.

# API
API_PORT=3001
API_HOST=0.0.0.0
LOG_LEVEL=info

# PostgreSQL (local Docker Compose - jasasaja-os-dev)
POSTGRES_USER=jasasaja
POSTGRES_PASSWORD=change_me_local_dev_only
POSTGRES_DB=jasasaja_os_dev

# API database connection (local dev)
# Match POSTGRES_* values above when using docker-compose.yml.
DATABASE_URL=postgresql://jasasaja:change_me_local_dev_only@localhost:5433/jasasaja_os_dev

# Auth / Google Login (OD-003, Step 6) - placeholders only
APP_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback
OWNER_EMAILS=owner@example.com
AUTH_STATE_SECRET=replace_with_long_random_secret
SESSION_COOKIE_NAME=jasasaja_session
SESSION_TTL_HOURS=168
# SESSION_COOKIE_SECURE=true|false (optional; default inferred from APP_BASE_URL)
